memory = ConversationBufferMemory(
    memory_key="chat_history",
    return_messages=True,
    )

agent = initialize_agent(
    tools=tools,
    llm=llm,
    agent=AgentType.ZERO_SHOT_REACT_DESCRIPTION,
    verbose=True,
    memory=memory,
    max_iterations=5,
    agent_kwargs={
        "perfix": react_prompt.template
    },
    )

def agent_predict_multistep(state: str):
    prompt = """You are a helpful flu forecasting model. Your goal is to forecast flu cases in {state} and predict the trend for cases over the next two weeks from the following options: Substantial Increase, Increase, Stable, Decrease, Substantial Decrease.

You have access to the following tools:
1. Get Current Flu Cases
2. Get State Demographic Data
3. Get Vaccination Percent
4. Get Google Trends
5. Get ARIMA Forecast
6. Get LSTM Forecast
7. Get RNN Embeddings
8. Get Reddit Post Percent

Use step-by-step reasoning. You can call tool iteratively and refine your predictions.
"""
    return agent.run(prompt)

